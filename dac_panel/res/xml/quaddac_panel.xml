<?xml version="1.0" encoding="utf-8"?>
<!--
    Search-index-only data source: the panel UI is rendered with Jetpack Compose
    (QuadDACPanelScreen), but Settings search indexes each row below through
    QuadDACPanelSearchIndexablesProvider. Keep android:key and android:title in
    sync with the Compose UI; entries/attributes use platform attrs only so the
    androidx.preference dependency is not needed.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:key="quaddac_panel"
    android:title="@string/quad_dac">

    <SwitchPreference
        android:key="quaddac_switch"
        android:title="@string/quad_dac"
        android:summary="@string/quad_dac_on" />

    <PreferenceCategory android:title="@string/quad_dac_settings">

        <ListPreference
            android:key="hifi_mode_dropdown"
            android:title="@string/hifi_mode"
            android:entries="@array/hifi_mode_entry_values" />

        <SeekBarPreference
            android:key="avc_volume_seekbar"
            android:title="@string/avc_volume"
            android:summary="@string/avc_volume_summary" />

        <ListPreference
            android:key="sound_preset_dropdown"
            android:title="@string/sound_preset"
            android:entries="@array/sound_preset_entry_values" />

        <ListPreference
            android:key="digital_filter_dropdown"
            android:title="@string/digital_filter"
            android:entries="@array/digital_filter_entry_values" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/customizable_filter_settings">

        <ListPreference
            android:key="custom_filter_shape"
            android:title="@string/cf_shape"
            android:entries="@array/custom_filter_shapes" />

        <ListPreference
            android:key="custom_filter_symmetry"
            android:title="@string/cf_symmetry"
            android:entries="@array/custom_filter_symmetries" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/customizable_filter_coeffs"
        android:summary="@string/customizable_filter_coeffs_summary">

        <!-- Index titles are literals: the search indexer cannot format args -->
        <SeekBarPreference
            android:key="custom_filter_coeff0"
            android:title="Coefficient 0" />
        <SeekBarPreference
            android:key="custom_filter_coeff1"
            android:title="Coefficient 1" />
        <SeekBarPreference
            android:key="custom_filter_coeff2"
            android:title="Coefficient 2" />
        <SeekBarPreference
            android:key="custom_filter_coeff3"
            android:title="Coefficient 3" />
        <SeekBarPreference
            android:key="custom_filter_coeff4"
            android:title="Coefficient 4" />
        <SeekBarPreference
            android:key="custom_filter_coeff5"
            android:title="Coefficient 5" />
        <SeekBarPreference
            android:key="custom_filter_coeff6"
            android:title="Coefficient 6" />
        <SeekBarPreference
            android:key="custom_filter_coeff7"
            android:title="Coefficient 7" />
        <SeekBarPreference
            android:key="custom_filter_coeff8"
            android:title="Coefficient 8" />
        <SeekBarPreference
            android:key="custom_filter_coeff9"
            android:title="Coefficient 9" />
        <SeekBarPreference
            android:key="custom_filter_coeff10"
            android:title="Coefficient 10" />
        <SeekBarPreference
            android:key="custom_filter_coeff11"
            android:title="Coefficient 11" />
        <SeekBarPreference
            android:key="custom_filter_coeff12"
            android:title="Coefficient 12" />
        <SeekBarPreference
            android:key="custom_filter_coeff13"
            android:title="Coefficient 13" />

        <Preference
            android:key="reset_coefficients"
            android:title="@string/cf_reset" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/quad_dac_balance">

        <Preference
            android:key="balance"
            android:title="@string/quad_dac_balance"
            android:summary="@string/quad_dac_balance_summary" />

    </PreferenceCategory>

</PreferenceScreen>
