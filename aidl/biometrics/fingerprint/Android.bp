
soong_config_module_type {
    name: "lge_fingerprint_service_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "LGE_FINGERPRINT_HAL",
    bool_variables: ["TARGET_HAS_EGISTEC_UDFPS"],
    properties: ["cflags"],
}

lge_fingerprint_service_cc_defaults {
    name: "lge_fingerprint_service_defaults",
    soong_config_variables: {
        TARGET_HAS_EGISTEC_UDFPS: {
            cflags: ["-DLGE_EGISTEC_UDFPS"],
        },
    },
}

cc_binary {
    name: "android.hardware.biometrics.fingerprint-service.lge",
    defaults: [
        "lge_fingerprint_service_defaults",
    ],
    init_rc: ["android.hardware.biometrics.fingerprint-service.lge.rc"],
    vintf_fragments: ["android.hardware.biometrics.fingerprint-service.lge.xml"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "service.cpp",
        "Fingerprint.cpp",
        "Session.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libhardware",
        "libutils",
        "android.hardware.biometrics.fingerprint-V1-ndk",
        "vendor.lge.hardware.biometrics.fingerprint-V1-aidl-V1-ndk",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
    ],
}
